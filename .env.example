# ══════════════════════════════════════════════════════════════
# url-destroyer 完整配置模板
# ══════════════════════════════════════════════════════════════
# 使用方法：
#   1. 复制为 .env：  cp .env.example .env
#                     （Windows: copy .env.example .env）
#   2. 修改下面的值（# 开头的行是注释，不需要可以删除）
#   3. 生效：         docker compose up -d
#
# 注意：
#   • .env 已被 .gitignore 忽略（含密码等敏感信息），不会提交到仓库
#   • 修改 .env 后只需重建容器（docker compose up -d），不需要 --build
#   • 所有变量均有默认值，不设置也能正常运行（全部使用默认配置）
#   • 优先级：后台设置页 > .env 环境变量 > 代码默认值
# ══════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
# 一、核心配置
# ──────────────────────────────────────────────────────────────

# 管理员初始密码
# 首次登录后可在后台设置页修改；修改后以数据库存储值为准
ADMIN_PASSWORD=admin123

# 首次访问后链接超时时间（小时）
# 用户打开链接后，超过该小时数未提交则链接自动过期
# 示例：24 = 1 天，48 = 2 天
DEFAULT_ACCESS_TIMEOUT=24

# 创建后未打开自动过期时间（小时）
# 链接创建后，超过该小时数无人访问则自动失效
# 示例：168 = 7 天，720 = 30 天
DEFAULT_ABSOLUTE_EXPIRY_HOURS=168

# 站点完整 URL（可选的）
# 仅在使用反向代理 / HTTPS / 自定义域名时需要设置，
# 用于生成正确的绝对链接。不设置则自动检测。
# 示例：BASE_URL=https://links.example.com
# BASE_URL=

# 后台入口路径（可选的，防扫描建议修改）
# 默认后台地址：/admin/
# 修改后需访问：/{ADMIN_PATH}/
# 示例：ADMIN_PATH=my-secret-panel
# ADMIN_PATH=admin


# ──────────────────────────────────────────────────────────────
# 二、数据持久化（SQLite 模式）
# ──────────────────────────────────────────────────────────────

# 数据目录（宿主机路径，用于挂载数据库卷）
# 强烈建议使用绝对路径，确保从任何目录运行 docker compose
# 数据都在同一位置，更新镜像也不会丢失。
# 示例（Linux）：DATA_DIR=/opt/url-destroyer/data
# 示例（macOS）：DATA_DIR=/Users/xxx/url-destroyer/data
# 不设置则默认使用 docker-compose.yml 同目录下的 ./data
DATA_DIR=./data

# SQLite 数据库文件路径（容器内路径，一般无需修改）
# 修改需与 docker-compose.yml 的卷挂载保持一致
# DB_PATH=/var/www/data/app.db


# ──────────────────────────────────────────────────────────────
# 三、数据库通用配置
# ──────────────────────────────────────────────────────────────

# 数据库驱动：sqlite（默认）或 mysql
# 设为 mysql 后启用下面的 MySQL 配置段
DB_DRIVER=sqlite

# 表名前缀
# 所有数据表自动添加此前缀，如：ud_links, ud_settings
# 设为空字符串（DB_TABLE_PREFIX=）则不使用前缀
# 注意：修改前缀后旧表不会被自动重命名，需手动迁移
DB_TABLE_PREFIX=ud_


# ──────────────────────────────────────────────────────────────
# 四、MySQL 配置（仅 DB_DRIVER=mysql 时生效）
# ──────────────────────────────────────────────────────────────

# MySQL 服务器地址
# 使用 docker compose 时，可填 MySQL 服务名（如 mysql-container）
# 示例：DB_HOST=127.0.0.1
# DB_HOST=127.0.0.1

# MySQL 端口（默认 3306）
# DB_PORT=3306

# 数据库名称（首次启动自动创建数据表，需先建好数据库本身）
# DB_DATABASE=url_destroyer

# 连接用户名
# DB_USERNAME=root

# 连接密码
# DB_PASSWORD=

# 连接字符集（一般无需修改）
# DB_CHARSET=utf8mb4
